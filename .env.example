# farmOS v1 — environment template. Copy to .env and fill in. .env is gitignored.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — your cloud PostgreSQL connection string.
# Leave unset to fall back to a local SQLite file for the Stage A prototype.
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Production-only (Coolify / TLS proxy) — not needed for local dev
# CSRF_TRUSTED_ORIGINS=https://farm.example.com
